{
    "id": "aviation-charts-engine",
    "load": true,
    "supported_archs": [
        "x86_64"
    ],
    "supported_host_types": [
        "ubuntu"
    ],
    "type": "dependency",
    "env": {
        "CC": "${LLVM_BINDIR}/clang",
        "CXX": "${LLVM_BINDIR}/clang++",
        "PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-ninja:${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/bin:$PATH",
        "LD_LIBRARY_PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/lib",
        "AVCHART_SRC_DIR": "${FLUTTER_WORKSPACE}/app/aviation-charts-engine",
        "AVCHART_BUILD_DIR": "${FLUTTER_WORKSPACE}/app/aviation-charts-engine/build",
        "AVCHART_STAGING_DIR": "${FLUTTER_WORKSPACE}/app/aviation-charts-engine/staging",
        "AVCHART_CMAKE_ARGS": "-DCMAKE_STAGING_PREFIX=${AVCHART_STAGING_DIR}"
    },
    "src": [
        {
            "uri": "git@github.com:uAvionixCorporation/aviation-charts-engine.git",
            "version": "master"
        }
    ],
    "runtime": {
        "post_cmds": [
            {
                "cwd": "${AVCHART_SRC_DIR}",
                "cmds": [
                    "git reset --hard master"
                ]
            },
            {
                "cwd": "${AVCHART_BUILD_DIR}",
                "cmds": [
                    "bash -c \"rm -rf CMakeCache.txt CMakeFiles | true\"",
                    "cmake -GNinja -S ${AVCHART_SRC_DIR} -B ${AVCHART_BUILD_DIR} ${AVCHART_CMAKE_ARGS}",
                    "cmake --build . --config Release --target install"
                ]
            }
        ],
        "do_clean": [
            {
                "cwd": "${AVCHART_BUILD_DIR}",
                "cmds": [
                    "ninja -t clean"
                ]
            }
        ]
    }
}
