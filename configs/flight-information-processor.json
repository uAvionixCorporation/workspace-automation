{
    "id": "flight-information-processor",
    "load": true,
    "supported_archs": [
        "x86_64"
    ],
    "supported_host_types": [
        "ubuntu"
    ],
    "type": "dependency",
    "env": {
        "CC": "${LLVM_BINDIR}/clang",
        "CXX": "${LLVM_BINDIR}/clang++",
        "PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-ninja:${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/bin:$PATH",
        "LD_LIBRARY_PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/lib",
        "FIP_SRC_DIR": "${FLUTTER_WORKSPACE}/app/flight-information-processor",
        "FIP_BUILD_DIR": "${FLUTTER_WORKSPACE}/app/flight-information-processor/build",
        "FIP_STAGING_DIR": "${FLUTTER_WORKSPACE}/app/flight-information-processor/staging",
        "FIP_CMAKE_ARGS": "-DCMAKE_STAGING_PREFIX=${FIP_STAGING_DIR}"
    },
    "src": [
        {
            "uri": "git@github.com:uAvionixCorporation/flight-information-processor.git",
            "version": "master"
        }
    ],
    "runtime": {
        "post_cmds": [
            {
                "cwd": "${FIP_SRC_DIR}",
                "cmds": [
                    "git reset --hard master"
                ]
            },
            {
                "cwd": "${FIP_BUILD_DIR}",
                "cmds": [
                    "bash -c \"rm -rf CMakeCache.txt CMakeFiles | true\"",
                    "cmake -GNinja -S ${FIP_SRC_DIR} -B ${FIP_BUILD_DIR} ${FIP_CMAKE_ARGS}",
                    "cmake --build . --config Release --target install"
                ]
            }
        ],
        "do_clean": [
            {
                "cwd": "${FIP_BUILD_DIR}",
                "cmds": [
                    "ninja -t clean"
                ]
            }
        ]
    }
}
