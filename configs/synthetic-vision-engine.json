{
    "id": "synthetic-vision-engine",
    "load": true,
    "supported_archs": [
        "x86_64",
	"aarch64",
        "arm64"
    ],
    "supported_host_types": [
        "ubuntu"
    ],
    "type": "dependency",
    "env": {
        "CC": "${LLVM_BINDIR}/clang",
        "CXX": "${LLVM_BINDIR}/clang++",
        "PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-ninja:${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/bin:$PATH",
        "LD_LIBRARY_PATH": "${FLUTTER_WORKSPACE}/.config/flutter_workspace/toolchain-common-cmake/lib",
        "SYNTH_VIS_SRC_DIR": "${FLUTTER_WORKSPACE}/app/synthetic-vision-engine",
        "SYNTH_VIS_BUILD_DIR": "${FLUTTER_WORKSPACE}/app/synthetic-vision-engine/build",
        "SYNTH_VIS_STAGING_DIR": "${FLUTTER_WORKSPACE}/app/synthetic-vision-engine/staging",
        "SYNTH_VIS_CMAKE_ARGS": "-DCMAKE_STAGING_PREFIX=${SYNTH_VIS_STAGING_DIR}"
    },
    "src": [
        {
            "uri": "git@github.com:uAvionixCorporation/synthetic-vision-engine.git",
            "version": "master"
        }
    ],
    "runtime": {
        "pre-requisites": {
            "x86_64": {
                "ubuntu": {
                    "cmds": [
                        "sudo apt-get install -yq libsdl2-dev libsdl2-image-dev"
                    ]
                }
            },
            "aarch64": {
                "ubuntu": {
                    "cmds": [
                        "sudo apt-get install -yq libsdl2-dev libsdl2-image-dev libgdal-dev glslang-dev spirv-tools"
                    ]
                }
            }            
        },
        "post_cmds": [
            {
                "cwd": "${SYNTH_VIS_SRC_DIR}",
                "cmds": [
                    "git reset --hard master"
                ]
            },
            {
                "cwd": "${SYNTH_VIS_BUILD_DIR}",
                "cmds": [
                    "bash -c \"rm -rf CMakeCache.txt CMakeFiles | true\"",
                    "cmake -GNinja -S ${SYNTH_VIS_SRC_DIR} -B ${SYNTH_VIS_BUILD_DIR} ${SYNTH_VIS_CMAKE_ARGS}",
                    "cmake --build . --config Release --target install"
                ]
            }
        ],
        "do_clean": [
            {
                "cwd": "${SYNTH_VIS_BUILD_DIR}",
                "cmds": [
                    "ninja -t clean"
                ]
            }
        ]
    }
}
